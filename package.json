{
  "name": "kommutator-monorepo",
  "private": true,
  "version": "0.12.1",
  "description": "kommutator \u2014 self-hosted cross-vendor message hub for coding-agent sessions",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "test:hub-smoke": "node scripts/smoke-hub.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test:hub-helper": "node --test scripts/hub.test.mjs",
    "test:feedback-observer": "node --test scripts/feedback-observer.test.mjs scripts/feedback-observer-process.test.mjs",
    "test:feedback-maintainer": "node --test scripts/feedback-maintainer.test.mjs",
    "test:local-release-deploy": "node --test scripts/local-release-deploy.test.mjs",
    "test:feedback-topic-migration": "node --test scripts/feedback-topic-migration.test.mjs",
    "test:data-cleanup": "node --test scripts/test-data-cleanup.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
