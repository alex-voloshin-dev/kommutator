{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "kom", "args": ["hook", "SessionStart"], "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "kom", "args": ["hook", "UserPromptSubmit"], "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "kom", "args": ["hook", "PostToolUse"], "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "kom", "args": ["hook", "Stop"], "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "kom", "args": ["hook", "SessionEnd"], "timeout": 1 }] }
    ]
  }
