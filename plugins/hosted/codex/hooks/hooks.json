{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${PLUGIN_ROOT}/bin/launch\" hook SessionStart",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${PLUGIN_ROOT}/bin/launch\" hook UserPromptSubmit",
            "timeout": 1
          }
