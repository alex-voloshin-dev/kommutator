    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${PLUGIN_ROOT}/bin/launch\" hook Stop",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${PLUGIN_ROOT}/bin/launch\" hook SessionEnd",
            "timeout": 1
          }
