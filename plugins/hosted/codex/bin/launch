#!/bin/sh
# Generated by scripts/package-client-release.mjs. Download only on the MCP/manage path.
set -eu
umask 077
vendor='codex'
expected='c76a29ffb339fd15e0c0f537da058852066ad1f556e0e4b786242f25227eb634'
url='https://github.com/alex-voloshin-dev/kommutator/releases/download/v0.4.0/kommutator-v0.4.0-linux-x64.tar.gz'
mode=${1:-mcp}
[ "$#" -eq 0 ] || shift
fail() { printf 'kommutator: %s\n' "$*" >&2; exit 1; }
home=${KOM_HOME:-"$HOME/.kommutator"}
case "$home" in /*) ;; *) [ "$mode" != hook ] || exit 0; fail 'Private state path must be absolute.' ;; esac
cache="$home/downloads"
target="$cache/$expected"
bundle="$target/bundle"
if [ "$mode" = hook ]; then
  # Do not create files, acquire locks, download, unpack, or print on the hook path.
  [ ! -L "$home" ] && [ ! -L "$cache" ] && [ ! -L "$target" ] && [ ! -L "$bundle" ] || exit 0
  [ -f "$target/ready" ] && [ -x "$bundle/plugins/$vendor/bin/hook" ] || exit 0
  owner=$(id -u)
  for directory in "$home" "$cache" "$target"; do
    [ "$(stat -c '%u:%a' -- "$directory" 2>/dev/null)" = "$owner:700" ] || exit 0
  done
  exec "$bundle/plugins/$vendor/bin/hook" "$@" 2>/dev/null
  exit 0
fi
case "$mode" in mcp|manage) ;; *) fail 'Unknown launcher mode.' ;; esac
[ "$(uname -s)" = Linux ] && [ "$(uname -m)" = x86_64 ] || fail 'This preview supports Linux x64 / WSL2 Ubuntu x64 only.'
for command in curl sha256sum tar gzip flock stat mktemp realpath; do
  command -v "$command" >/dev/null 2>&1 || fail "Install $command first (Ubuntu: curl coreutils tar util-linux)."
done
owner=$(id -u)
private_dir() {
  [ ! -L "$1" ] || fail 'Private cache must not be a symbolic link.'
  mkdir -p -- "$1"
  [ "$(stat -c %u -- "$1")" = "$owner" ] || fail 'Private cache belongs to another user.'
  [ "$(realpath -- "$1")" = "$1" ] || fail 'Private cache path must be canonical without symbolic links.'
  chmod 700 -- "$1"
}
private_dir "$home"
private_dir "$cache"
[ ! -L "$cache/$expected.lock" ] || fail 'Unsafe cache lock.'
if [ -e "$cache/$expected.lock" ]; then
  [ -f "$cache/$expected.lock" ] && [ "$(stat -c %u -- "$cache/$expected.lock")" = "$owner" ] || fail 'Unsafe cache lock.'
fi
exec 9>"$cache/$expected.lock"
flock -w 180 9 || fail 'Another client download is still running. Retry MCP connection.'
[ ! -L "$target" ] || fail 'Unsafe cached release.'
if [ ! -f "$target/ready" ]; then
  [ ! -e "$target" ] || fail 'Incomplete cached release; remove that release directory and retry.'
  stage=$(mktemp -d "$cache/.download.XXXXXXXX")
  trap 'rm -rf -- "$stage"' EXIT
  trap 'exit 1' HUP INT TERM
  printf 'kommutator: downloading verified Linux x64 client once...\n' >&2
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 15 --max-time 150 --max-filesize 268435456 --output "$stage/client.tar.gz" "$url" || fail 'Client download failed. Check internet access and reconnect the MCP server.'
  printf '%s  %s\n' "$expected" "$stage/client.tar.gz" | sha256sum -c - >/dev/null || fail 'Client checksum mismatch; nothing was installed.'
  mkdir "$stage/bundle"
  tar --extract --gzip --file "$stage/client.tar.gz" --directory "$stage/bundle" --no-same-owner --no-same-permissions || fail 'Client archive extraction failed.'
  [ -x "$stage/bundle/plugins/$vendor/bin/mcp" ] && [ -x "$stage/bundle/plugins/$vendor/runtime/payload/node" ] || fail 'Client archive is incomplete.'
  rm -- "$stage/client.tar.gz"
  printf '%s\n' "$expected" > "$stage/ready"
  mv -- "$stage" "$target"
  trap - EXIT HUP INT TERM
fi
[ ! -L "$target/ready" ] && [ ! -L "$bundle" ] && [ "$(cat "$target/ready")" = "$expected" ] || fail 'Invalid cached release.'
[ "$(stat -c %u -- "$target")" = "$owner" ] && [ "$(stat -c %a -- "$target")" = 700 ] || fail 'Unsafe cached release permissions.'
flock -u 9
exec 9>&-
if [ "$mode" = manage ]; then exec "$bundle/plugins/$vendor/bin/manage" "$@"; fi
exec "$bundle/plugins/$vendor/bin/mcp" "$@"
