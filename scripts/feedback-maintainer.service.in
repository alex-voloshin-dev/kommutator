[Unit]
Description=Kommutator autonomous feedback maintainer
After=network-online.target kommutator-feedback.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@NODE@ @REPO@/scripts/feedback-maintainer.mjs run --policy @POLICY@ --state @STATE@
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=75
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_CACHE_HOME=@STATE@/cache
Environment=XDG_DATA_HOME=@STATE@/data
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE@ %h/.codex
ReadOnlyPaths=@POLICY@
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
