{
  "license": "MIT",
  "name": "@kommutator/hub",
  "version": "0.8.0",
  "description": "kommutator hub: sessions, topics, messages, boards; ws + SQLite; read-only dashboard",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./db": "./dist/db.js",
    "./testing": "./dist/testing.js"
  },
  "bin": {
    "kommutator-hub": "./dist/index.js"
  },
  "files": ["dist", "schema.sql", "public"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "dev": "node --watch dist/index.js"
  },
  "dependencies": {
    "@kommutator/protocol": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0"
  }
}
