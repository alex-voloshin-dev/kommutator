{
  "license": "MIT",
  "name": "kommutator",
  "version": "0.2.2",
  "description": "kommutator \u2014 switchboard for coding agents. CLI, daemon, MCP shim and hooks in one binary: kom",
  "type": "module",
  "bin": {
    "kom": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\""
  },
  "dependencies": {
    "@kommutator/agentd": "workspace:*",
    "@kommutator/hub": "workspace:*",
    "@kommutator/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "citty": "^0.1.6",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "repository": "github:alex-voloshin-dev/kommutator"
}
