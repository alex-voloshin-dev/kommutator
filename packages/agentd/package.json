{
  "license": "MIT",
  "name": "@kommutator/agentd",
  "version": "0.13.1",
  "description": "kommutator per-host daemon: hub link, local IPC, outbox, vendor adapters",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\""
  },
  "dependencies": {
    "@kommutator/protocol": "workspace:*",
    "ws": "^8.22.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@kommutator/hub": "workspace:*",
    "@types/ws": "^8.18.0"
  }
}
